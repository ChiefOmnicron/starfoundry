  "query": "\n            SELECT\n                manufacturing,\n                reaction,\n                copying,\n                invention,\n                research_time,\n                research_material\n            FROM system_index\n            WHERE system_id = $1\n            AND timestamp >= $2\n            AND timestamp <= $3\n            ORDER BY timestamp DESC\n        ",
